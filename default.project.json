{
  "name": "MiningGame",
  "tree": {
    "$className": "DataModel",

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": {
        "$path": "src/server"
      }
    },

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/shared"
      },
      "Remotes": {
        "$className": "Folder",
        "MineNode": { "$className": "RemoteEvent" },
        "InventoryUpdated": { "$className": "RemoteEvent" },
        "MiningFeedback": { "$className": "RemoteEvent" },
        "CurrencyUpdated": { "$className": "RemoteEvent" },
        "RequestTeleport": { "$className": "RemoteEvent" },
        "OpenPanel": { "$className": "RemoteEvent" },
        "RequestSell": { "$className": "RemoteEvent" },
        "SellResult": { "$className": "RemoteEvent" },
        "RequestBuy": { "$className": "RemoteEvent" },
        "BuyResult": { "$className": "RemoteEvent" },
        "DeathFeedback": { "$className": "RemoteEvent" },
        "CargoStatus": { "$className": "RemoteEvent" },
        "RequestNotice": { "$className": "RemoteEvent" },
        "ShowNotice": { "$className": "RemoteEvent" },
        "RequestRespawn": { "$className": "RemoteEvent" }
      }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$path": "src/client"
        }
      },
      "StarterCharacterScripts": {
        "$className": "StarterCharacterScripts",
        "$path": "src/character"
      }
    },

    "Workspace": {
      "$className": "Workspace"
    }
  }
}
